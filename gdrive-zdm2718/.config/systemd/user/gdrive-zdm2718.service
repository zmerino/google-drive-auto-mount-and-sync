# ~/.config/systemd/user/gdrive-zdm2718.service
[Unit]
Description=Mount Google Drive (zdm2718) with ocamlfuse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/nm-online -q --timeout=30
ExecStartPre=/bin/mkdir -p %h/zdm2718_gdrive
ExecStart=/usr/bin/google-drive-ocamlfuse -label zdm2718 -f %h/zdm2718_gdrive
ExecStop=/usr/bin/fusermount -u %h/zdm2718_gdrive
Restart=always
RestartSec=5s
KillMode=control-group

[Install]
WantedBy=default.target

